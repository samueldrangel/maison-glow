<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Probador virtual del cliente (N-R05). Trabaja siempre sobre la cuenta que entro: no hay selector de cliente. Tres tarjetas:
     la foto (camara o archivo), el tono y su intensidad, y el resultado, que siempre lleva el aviso de que es una simulacion y
     no una garantia. Nada se guarda solo: "Guardar en Mis cambios" es una accion del cliente y la guarda como simulacion, no
     como un cambio real. Si el probador es el simulado, lo avisa arriba. Los textos de ejemplo se ven aqui para disenar.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.MyTryOnController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1200" prefHeight="760">
    <top>
        <VBox spacing="8">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Probador virtual" styleClass="view-title"/>
                <Label text="IA" styleClass="chip-gold"/>
            </HBox>
            <HBox fx:id="simulatedBanner" styleClass="banner-warning">
                <Label text="Probador simulado: el resultado es una imagen de ejemplo con el tono elegido, no una simulación real de inteligencia artificial." styleClass="banner-text" wrapText="true"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <HBox spacing="16">
            <VBox styleClass="card, form-card" spacing="8" prefWidth="0" HBox.hgrow="ALWAYS">
                <Label text="Tu foto" styleClass="form-title"/>
                <VBox fx:id="photoBox"/>
                <Label fx:id="needPhotoMessage" text="Mensaje de error" styleClass="field-error-message" wrapText="true"/>
            </VBox>
            <VBox styleClass="card, form-card" spacing="8" prefWidth="0" minWidth="300" HBox.hgrow="ALWAYS">
                <Label text="El tono" styleClass="form-title"/>
                <Label text="Elige un tono de cabello." styleClass="form-hint"/>
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefHeight="300">
                    <FlowPane fx:id="tonesPane" hgap="8" vgap="8"/>
                </ScrollPane>
                <Label fx:id="toneMessage" text="Mensaje de error" styleClass="field-error-message" wrapText="true"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Intensidad" styleClass="form-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="intensityValue" text="50%" styleClass="stat-value"/>
                </HBox>
                <Slider fx:id="intensitySlider" min="0.1" max="1.0" value="0.5"/>
            </VBox>
            <VBox styleClass="card, form-card" spacing="8" prefWidth="0" HBox.hgrow="ALWAYS">
                <Label text="Resultado" styleClass="form-title"/>
                <StackPane styleClass="photo-frame" minHeight="260" prefHeight="300">
                    <ImageView fx:id="resultView" fitWidth="300" fitHeight="280" preserveRatio="true"/>
                    <Label fx:id="resultPlaceholder" text="Aquí aparece el resultado" styleClass="placeholder-notice"/>
                </StackPane>
                <Label fx:id="disclaimerLabel" text="Simulación, no garantía" styleClass="form-hint" wrapText="true"/>
                <Button fx:id="generateButton" text="Generar simulación" styleClass="button-gold" maxWidth="Infinity"/>
                <Button fx:id="saveButton" text="Guardar en Mis cambios" styleClass="button-secondary" maxWidth="Infinity"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
