<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pestana Tratamientos de Profesionales y tratamientos. Cada tratamiento es una tarjeta que TreatmentsController
     arma al arrancar (aqui se ve una de ejemplo). El formulario es un panel que entra desde la derecha
     (SlidePanel); aqui se ve abierto para disenar. Los textos "Mensaje de error" se ven aqui para disenar;
     FieldValidator los oculta al arrancar. Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.TreatmentsController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="600">
    <padding><Insets top="14"/></padding>
    <center>
        <VBox spacing="14">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="searchField" promptText="Buscar tratamiento..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button fx:id="newButton" text="Nuevo tratamiento" styleClass="button-gold">
                    <graphic><StackPane styleClass="sparkle" minWidth="15" prefWidth="15" maxWidth="15" minHeight="15" prefHeight="15" maxHeight="15">
                        <SVGPath styleClass="line-icon" scaleX="0.625" scaleY="0.625" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/>
                    </StackPane></graphic>
                </Button>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="cardsPane" hgap="14" vgap="14" styleClass="side-column" style="-fx-padding: 4 4 16 4;">
                    <VBox styleClass="card, tre-card" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="2">
                            <Label text="Activo" styleClass="chip-success"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button styleClass="icon-button" text="Editar"/>
                        </HBox>
                        <Label text="Manicura gel" styleClass="tre-name" wrapText="true"/>
                        <Label text="Esmaltado semipermanente con limado y cuidado de cutículas." styleClass="tre-description" wrapText="true"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="50 min" styleClass="tre-meta"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="\$ 45.000" styleClass="tre-price"/>
                        </HBox>
                    </VBox>
                </FlowPane>
            </ScrollPane>
            <Label fx:id="countLabel" text="Mostrando 1 de 1 tratamiento" styleClass="stat-caption"/>
        </VBox>
    </center>
    <right>
        <HBox>
            <ScrollPane fx:id="formPanel" fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefWidth="330" minWidth="330">
                <VBox spacing="16" styleClass="side-column" style="-fx-padding: 0 4 16 20;">
                    <VBox styleClass="card, form-card" spacing="6">
                        <Label fx:id="formTitle" text="Registrar tratamiento" styleClass="form-title"/>

                        <Label text="Nombre" styleClass="form-label"/>
                        <TextField fx:id="nameField" promptText="Nombre del tratamiento"/>
                        <Label fx:id="nameMessage" text="Mensaje de error" styleClass="field-error-message"/>

                        <Label text="Descripción" styleClass="form-label"/>
                        <TextArea fx:id="descriptionField" promptText="Qué incluye (opcional)" prefRowCount="4" wrapText="true"/>

                        <HBox spacing="10">
                            <VBox spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                                <Label text="Precio" styleClass="form-label"/>
                                <TextField fx:id="priceField" promptText="45000"/>
                                <Label fx:id="priceMessage" text="Mensaje de error" styleClass="field-error-message"/>
                            </VBox>
                            <VBox spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                                <Label text="Duración (min)" styleClass="form-label"/>
                                <TextField fx:id="durationField" promptText="60"/>
                                <Label fx:id="durationMessage" text="Mensaje de error" styleClass="field-error-message"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <padding><Insets top="10"/></padding>
                            <Button fx:id="saveButton" text="Guardar" styleClass="button-primary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="cancelButton" text="Cancelar" styleClass="button-secondary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </right>
</BorderPane>
