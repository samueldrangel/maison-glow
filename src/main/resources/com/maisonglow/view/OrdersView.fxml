<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de Pedidos del administrador (I-R04). A la izquierda la lista con su estado y los filtros por estado y por
     texto; a la derecha el detalle del pedido elegido: estado, lineas, total, hasta cuando esta reservado el stock y los
     botones para confirmar el pago, cancelar o ver el comprobante. Un pedido pendiente NUNCA se presenta como pagado:
     avisa que el stock esta reservado, no vendido. Aun no esta en el menu: se conecta cuando exista el servicio de
     pedidos (S-R04). Las filas y los textos de detalle son de ejemplo para disenar; OrdersController los reemplaza.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.OrdersController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1100" prefHeight="700">
    <top>
        <VBox spacing="10">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Pedidos" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="filterChips" alignment="CENTER_RIGHT" spacing="8">
                    <ToggleButton text="Pendientes de pago" selected="true" styleClass="filter-chip">
                        <toggleGroup><ToggleGroup fx:id="filters"/></toggleGroup>
                    </ToggleButton>
                    <ToggleButton text="Pagados" styleClass="filter-chip">
                        <toggleGroup><fx:reference source="filters"/></toggleGroup>
                    </ToggleButton>
                    <ToggleButton text="Cancelados y vencidos" styleClass="filter-chip">
                        <toggleGroup><fx:reference source="filters"/></toggleGroup>
                    </ToggleButton>
                    <ToggleButton text="Todos" styleClass="filter-chip">
                        <toggleGroup><fx:reference source="filters"/></toggleGroup>
                    </ToggleButton>
                </HBox>
            </HBox>
            <TextField fx:id="searchField" promptText="Buscar por cliente o número de pedido..." styleClass="search-field"/>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="tableHost">
            <TableView fx:id="ordersTable" styleClass="compact-table">
                <columns>
                    <TableColumn fx:id="numberColumn" text="N.º" prefWidth="50"/>
                    <TableColumn fx:id="customerColumn" text="Cliente" prefWidth="150"/>
                    <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="110"/>
                    <TableColumn fx:id="totalColumn" text="Total" prefWidth="90"/>
                    <TableColumn fx:id="stateColumn" text="Estado" prefWidth="140"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label fx:id="emptyLabel" text="No hay pedidos en esta lista." styleClass="placeholder-notice"/></placeholder>
            </TableView>
        </StackPane>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefWidth="340" minWidth="340">
            <VBox spacing="16" styleClass="side-column">
                <VBox styleClass="card, form-card" spacing="8">
                    <Label fx:id="detailEmpty" text="Elige un pedido para ver su detalle." styleClass="placeholder-notice" wrapText="true"/>
                    <VBox fx:id="detailBox" spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="detailTitle" text="Pedido n.º 12" styleClass="form-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="detailState" text="Pendiente de pago" styleClass="chip-gold"/>
                        </HBox>
                        <Label fx:id="detailCustomer" text="Ana García · 17/11/2026 09:30" styleClass="form-hint"/>
                        <HBox fx:id="unpaidNote" styleClass="banner-warning">
                            <Label text="Aún no está pagado: el stock está reservado, no vendido." styleClass="banner-text" wrapText="true"/>
                        </HBox>
                        <VBox fx:id="linesBox" spacing="6">
                            <Label text="2 × Mascarilla Reparadora · \$ 70.000" styleClass="form-hint"/>
                        </VBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Total" styleClass="stat-caption"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="totalLabel" text="\$ 70.000" styleClass="stat-number"/>
                        </HBox>
                        <Label fx:id="reservationLabel" text="Reserva activa hasta las 10:00 (quedan 30 min)" styleClass="form-hint" wrapText="true"/>
                        <VBox fx:id="paymentBox" spacing="6">
                            <Label text="Forma de pago" styleClass="form-label"/>
                            <ComboBox fx:id="methodBox" promptText="Selecciona" maxWidth="Infinity"/>
                            <Label fx:id="methodMessage" text="Mensaje de error" styleClass="field-error-message"/>
                        </VBox>
                        <HBox spacing="10">
                            <padding><Insets top="6"/></padding>
                            <Button fx:id="payButton" text="Confirmar pago" styleClass="button-gold, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="cancelButton" text="Cancelar pedido" styleClass="button-secondary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <Button fx:id="receiptButton" text="Ver comprobante de venta" styleClass="button-secondary, button-compact" maxWidth="Infinity"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
