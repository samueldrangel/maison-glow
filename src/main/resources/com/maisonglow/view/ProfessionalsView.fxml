<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<!-- Pantalla de Profesionales y servicios (mockup M3): una pestana por tema. Cada pestana es su propio
     archivo (TreatmentsPane.fxml, ...) con su controlador; aqui solo se reunen. En Scene Builder abre cada
     pestana con su archivo para editarla. Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="660">
    <top>
        <Label text="Profesionales y servicios" styleClass="view-title">
            <BorderPane.margin><Insets bottom="10"/></BorderPane.margin>
        </Label>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Tratamientos">
                <content><fx:include source="TreatmentsPane.fxml"/></content>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
