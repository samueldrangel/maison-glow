<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Carrito del cliente (N-R03). A la izquierda lo que lleva: cada producto con su precio, la cantidad con - y + y un boton
     para quitarlo. A la derecha el resumen: el total, el aviso de que se paga y se retira en el local y de que al confirmar se
     reservan los productos 30 minutos, y el boton "Confirmar pedido". Si entre tanto cambio un precio, bajo la disponibilidad o
     el negocio retiro un producto, se explica aqui y el pedido NO se envia hasta que el cliente vuelva a confirmar. Al confirmar
     aparece el pedido creado y donde pagarlo. Las filas de ejemplo se ven aqui para disenar; CartController las reemplaza.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.CartController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1100" prefHeight="700">
    <top>
        <VBox spacing="2">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <Label text="Carrito" styleClass="view-title"/>
            <Label text="Revisa tu pedido antes de confirmarlo." styleClass="form-hint"/>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="host">
            <VBox styleClass="card, form-card" spacing="10" maxHeight="-Infinity" StackPane.alignment="TOP_CENTER">
                <Label text="Tu pedido" styleClass="form-title"/>
                <VBox fx:id="linesBox" spacing="10">
                    <HBox styleClass="home-row" alignment="CENTER_LEFT" spacing="12">
                        <VBox spacing="2" HBox.hgrow="ALWAYS"><Label text="Sérum Vitamina C" styleClass="home-row-title"/><Label text="\$ 48.000 c/u" styleClass="home-row-detail"/></VBox>
                        <Label text="\$ 96.000" styleClass="shop-price"/>
                    </HBox>
                </VBox>
                <Label fx:id="emptyLabel" text="Tu carrito está vacío. Agrega productos desde la «Tienda»." styleClass="home-empty" wrapText="true"/>
            </VBox>
        </StackPane>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefWidth="340" minWidth="340">
            <VBox spacing="16" styleClass="side-column">
                <VBox styleClass="card, form-card" spacing="8">
                    <Label text="Resumen" styleClass="form-title"/>
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Total" styleClass="stat-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalLabel" text="\$ 96.000" styleClass="shop-price-big"/>
                    </HBox>
                    <Label fx:id="countLabel" text="2 unidades" styleClass="form-hint"/>
                    <HBox fx:id="changesBox" styleClass="banner-warning">
                        <Label fx:id="changesText" text="El precio de Sérum Vitamina C cambió de \$ 48.000 a \$ 50.000." styleClass="banner-text" wrapText="true"/>
                    </HBox>
                    <Label text="Se paga y se retira en el local. Al confirmar reservamos tus productos durante 30 minutos; si no los pagas en ese tiempo, la reserva se libera." styleClass="form-hint" wrapText="true"/>
                    <Button fx:id="confirmButton" text="Confirmar pedido" styleClass="button-gold, button-compact" maxWidth="Infinity">
                        <VBox.margin><Insets top="6"/></VBox.margin>
                    </Button>
                </VBox>
                <VBox fx:id="resultBox" styleClass="card, form-card" spacing="8">
                    <Label fx:id="resultTitle" text="Pedido n.º 3 creado" styleClass="form-title"/>
                    <Label fx:id="resultText" text="Págalo en el local antes de las 15:30." styleClass="form-hint" wrapText="true"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
