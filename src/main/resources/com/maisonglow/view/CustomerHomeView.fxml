<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Inicio del cliente (N-R01). Cabecera con el saludo por nombre y una frase con lo que viene; tres indicadores propios
     (citas, compras y pedidos por pagar) y dos tarjetas: la proxima cita y los pedidos recientes. Todo lo que se ve es de la
     cuenta que entro; si aun no hay nada, cada tarjeta lo dice y dice donde empezar. Los textos de ejemplo se ven aqui para
     disenar; CustomerHomeController los reemplaza.
     Colores y formas: View > Scene Style Sheets > styles.css (clases home-*). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.CustomerHomeController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1100" prefHeight="700">
    <top>
        <HBox styleClass="home-hero" alignment="CENTER_LEFT" spacing="16">
            <BorderPane.margin><Insets bottom="18"/></BorderPane.margin>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="MAISON GLOW" styleClass="home-eyebrow"/>
                <Label fx:id="greetingLabel" text="Buenas tardes, Ana" styleClass="home-greeting"/>
                <Label fx:id="dateLabel" text="Martes, 18 de noviembre de 2026" styleClass="home-date"/>
                <Label fx:id="summaryLabel" text="Tu próxima cita es el jueves a las 10:00." styleClass="home-summary" wrapText="true"/>
            </VBox>
            <StackPane styleClass="home-hero-star" minWidth="64" prefWidth="64" maxWidth="64" minHeight="64" prefHeight="64" maxHeight="64">
                <SVGPath styleClass="home-hero-star-icon" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" scaleX="1.6" scaleY="1.6"/>
            </StackPane>
        </HBox>
    </top>
    <center>
        <VBox spacing="18">
            <HBox spacing="14">
                <HBox styleClass="home-kpi, home-kpi-gold" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Mis citas" styleClass="stat-caption"/><Label fx:id="appointmentsValue" text="3" styleClass="home-kpi-number"/><Label fx:id="appointmentsNote" text="1 por atender" styleClass="home-kpi-note"/></VBox>
                </HBox>
                <HBox styleClass="home-kpi, home-kpi-green" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Mis compras" styleClass="stat-caption"/><Label fx:id="purchasesValue" text="2" styleClass="home-kpi-number"/><Label fx:id="purchasesNote" text="\$ 96.000 en total" styleClass="home-kpi-note"/></VBox>
                </HBox>
                <HBox styleClass="home-kpi, home-kpi-rose" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M12 6v6l4 2M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Pedidos por pagar" styleClass="stat-caption"/><Label fx:id="pendingOrdersValue" text="1" styleClass="home-kpi-number"/><Label text="Se pagan en el local" styleClass="home-kpi-note"/></VBox>
                </HBox>
            </HBox>
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox styleClass="card, form-card" spacing="12" prefWidth="0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Próxima cita" styleClass="home-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="nextState" text="Pendiente" styleClass="chip-gold"/>
                    </HBox>
                    <VBox fx:id="nextBox" spacing="8">
                        <Label text="Corte y peinado" styleClass="home-row-title"/>
                        <Label text="Jueves 20/11/2026 10:00 · Camila Ruiz" styleClass="home-row-detail"/>
                    </VBox>
                    <Label fx:id="nextEmpty" text="Aún no tienes citas próximas. Reserva la primera en «Mis citas»." styleClass="home-empty" wrapText="true"/>
                </VBox>
                <VBox styleClass="card, form-card" spacing="12" prefWidth="0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Pedidos recientes" styleClass="home-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="ordersCount" text="1 pedido" styleClass="chip-rose"/>
                    </HBox>
                    <VBox fx:id="ordersBox" spacing="10">
                        <Label text="Pedido n.º 3 · $ 96.000" styleClass="form-hint"/>
                    </VBox>
                    <Label fx:id="ordersEmpty" text="Todavía no has hecho pedidos. Encuentra productos en la «Tienda»." styleClass="home-empty" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
