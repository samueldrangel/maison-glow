<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de Estadisticas y BI (mockup M7). Arriba el rango de fechas (tres atajos o dos fechas a mano) que
     gobierna un resumen (ingresos, citas, inasistencias y clientes nuevos), las graficas de productos, de tratamientos, el bloque de ingresos,
     del estado de las citas y de las citas por dia de la semana; debajo, los clientes frecuentes, los productos de baja
     rotacion (con el aviso al administrador) y las promociones sugeridas para el cliente que se elija. Cada grafica tiene un
     mensaje que ocupa su lugar cuando no hay datos en el rango. Las graficas salen vacias aqui; StatisticsController
     las llena al arrancar. Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.StatisticsController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="700">
    <top>
        <VBox spacing="4">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label text="Estadísticas" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="last7Chip" text="7 días" styleClass="filter-chip">
                    <toggleGroup><ToggleGroup fx:id="rangeChips"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="last30Chip" text="30 días" styleClass="filter-chip" selected="true">
                    <toggleGroup><fx:reference source="rangeChips"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="last90Chip" text="90 días" styleClass="filter-chip">
                    <toggleGroup><fx:reference source="rangeChips"/></toggleGroup>
                </ToggleButton>
                <Label text="Desde" styleClass="stat-caption"><padding><Insets left="10"/></padding></Label>
                <DatePicker fx:id="fromPicker" prefWidth="150"/>
                <Label text="Hasta" styleClass="stat-caption"/>
                <DatePicker fx:id="toPicker" prefWidth="150"/>
            </HBox>
            <Label fx:id="rangeMessage" text="Mensaje de error" styleClass="field-error-message"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="settings-scroll">
            <VBox spacing="16" styleClass="settings-column">
                <HBox spacing="16">
                    <VBox styleClass="stat-tile, stat-tile-gold" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Ingresos por ventas" styleClass="stat-caption"/><Label fx:id="revenueValue" text="\$ 175.000" styleClass="stat-number"/><Label fx:id="revenueNote" text="3 ventas" styleClass="stat-caption"/></VBox>
                    <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Citas" styleClass="stat-caption"/><Label fx:id="appointmentsValue" text="12" styleClass="stat-number"/></VBox>
                    <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Inasistencias" styleClass="stat-caption"/><Label fx:id="noShowValue" text="10 %" styleClass="stat-number"/></VBox>
                    <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Clientes nuevos" styleClass="stat-caption"/><Label fx:id="newCustomersValue" text="4" styleClass="stat-number"/></VBox>
                </HBox>
                <VBox styleClass="card, form-card" spacing="6">
                    <Label text="Ingresos" styleClass="form-title"/>
                    <HBox spacing="12">
                        <VBox styleClass="stat-tile, stat-tile-gold" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Total de ingresos" styleClass="stat-caption"/><Label fx:id="totalIncomeValue" text="\$ 285.000" styleClass="stat-number"/><Label fx:id="totalIncomeNote" text="" styleClass="stat-caption" wrapText="true"/></VBox>
                        <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Por tratamientos" styleClass="stat-caption"/><Label fx:id="treatmentIncomeValue" text="\$ 110.000" styleClass="stat-number"/><Label fx:id="treatmentIncomeNote" text="" styleClass="stat-caption" wrapText="true"/></VBox>
                        <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Anticipos por aplicar" styleClass="stat-caption"/><Label fx:id="pendingDepositsValue" text="\$ 16.500" styleClass="stat-number"/><Label fx:id="pendingDepositsNote" text="" styleClass="stat-caption" wrapText="true"/></VBox>
                        <VBox styleClass="stat-tile" prefWidth="0" HBox.hgrow="ALWAYS"><Label text="Ingreso perdido" styleClass="stat-caption"/><Label fx:id="lostIncomeValue" text="\$ 110.000" styleClass="stat-number"/><Label fx:id="lostIncomeNote" text="" styleClass="stat-caption" wrapText="true"/></VBox>
                    </HBox>
                </VBox>
                <HBox spacing="16">
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Productos más vendidos" styleClass="form-title"/>
                        <Label text="Unidades vendidas en el rango de fechas." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="productsChart" legendVisible="false" animated="false" categoryGap="10" prefHeight="260">
                                <xAxis><NumberAxis side="BOTTOM" tickUnit="1" minorTickVisible="false"/></xAxis>
                                <yAxis><CategoryAxis side="LEFT"/></yAxis>
                            </BarChart>
                            <Label fx:id="productsEmpty" text="Sin ventas de productos en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Tratamientos más agendados" styleClass="form-title"/>
                        <Label text="Citas no canceladas en el rango de fechas." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="treatmentsChart" legendVisible="false" animated="false" categoryGap="10" prefHeight="260">
                                <xAxis><NumberAxis side="BOTTOM" tickUnit="1" minorTickVisible="false"/></xAxis>
                                <yAxis><CategoryAxis side="LEFT"/></yAxis>
                            </BarChart>
                            <Label fx:id="treatmentsEmpty" text="Sin citas en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Estado de las citas" styleClass="form-title"/>
                        <Label text="Cómo terminaron las citas del rango de fechas." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="statusChart" legendVisible="false" animated="false" categoryGap="10" prefHeight="230">
                                <xAxis><NumberAxis side="BOTTOM" tickUnit="1" minorTickVisible="false"/></xAxis>
                                <yAxis><CategoryAxis side="LEFT"/></yAxis>
                            </BarChart>
                            <Label fx:id="statusEmpty" text="Sin citas en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Citas por día de la semana" styleClass="form-title"/>
                        <Label text="Sin contar las canceladas." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="weekdayChart" styleClass="weekday-chart" legendVisible="false" animated="false" categoryGap="14" prefHeight="230">
                                <xAxis><CategoryAxis side="BOTTOM"/></xAxis>
                                <yAxis><NumberAxis side="LEFT" tickUnit="1" minorTickVisible="false"/></yAxis>
                            </BarChart>
                            <Label fx:id="weekdayEmpty" text="Sin citas en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                </HBox>
                <HBox spacing="16">
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Ingresos por profesional" styleClass="form-title"/>
                        <Label text="Precio de las citas completadas de cada una." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="professionalIncomeChart" legendVisible="false" animated="false" categoryGap="10" prefHeight="230">
                                <xAxis><NumberAxis side="BOTTOM" minorTickVisible="false"/></xAxis>
                                <yAxis><CategoryAxis side="LEFT"/></yAxis>
                            </BarChart>
                            <Label fx:id="professionalIncomeEmpty" text="Sin citas completadas en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Ingresos por tratamiento" styleClass="form-title"/>
                        <Label text="Precio de las citas completadas de cada tratamiento." styleClass="form-hint"/>
                        <StackPane>
                            <BarChart fx:id="treatmentIncomeChart" legendVisible="false" animated="false" categoryGap="10" prefHeight="230">
                                <xAxis><NumberAxis side="BOTTOM" minorTickVisible="false"/></xAxis>
                                <yAxis><CategoryAxis side="LEFT"/></yAxis>
                            </BarChart>
                            <Label fx:id="treatmentIncomeEmpty" text="Sin citas completadas en este rango" styleClass="placeholder-notice" visible="false"/>
                        </StackPane>
                    </VBox>
                </HBox>
                <VBox styleClass="card, form-card" spacing="6">
                    <Label text="Clientes frecuentes" styleClass="form-title"/>
                    <Label text="Por número de compras, de toda la historia." styleClass="form-hint"/>
                    <TableView fx:id="customersTable" styleClass="compact-table" prefHeight="230">
                        <columns>
                            <TableColumn fx:id="rankColumn" text="#" prefWidth="50" sortable="false"/>
                            <TableColumn fx:id="customerNameColumn" text="Cliente" prefWidth="320" sortable="false"/>
                            <TableColumn fx:id="purchasesColumn" text="Compras" prefWidth="100" sortable="false"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <placeholder><Label text="Aún no hay compras registradas" styleClass="placeholder-notice"/></placeholder>
                    </TableView>
                </VBox>
                <HBox spacing="16">
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Baja rotación" styleClass="form-title"/>
                        <Label fx:id="lowRotationHint" text="Los que menos se vendieron en los últimos 30 días." styleClass="form-hint" wrapText="true"/>
                        <TableView fx:id="lowRotationTable" styleClass="compact-table" prefHeight="230">
                            <columns>
                                <TableColumn fx:id="lowNameColumn" text="Producto" prefWidth="200" sortable="false"/>
                                <TableColumn fx:id="lowStockColumn" text="En stock" prefWidth="80" sortable="false"/>
                                <TableColumn fx:id="lowSoldColumn" text="Vendidas" prefWidth="80" sortable="false"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="Ningún producto con baja rotación" styleClass="placeholder-notice"/></placeholder>
                        </TableView>
                        <Button fx:id="notifyButton" text="Avisar al administrador" styleClass="button-primary, button-compact" maxWidth="Infinity">
                            <VBox.margin><Insets top="6"/></VBox.margin>
                        </Button>
                    </VBox>
                    <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS">
                        <Label text="Promociones sugeridas" styleClass="form-title"/>
                        <Label text="Productos de baja rotación que el cliente aún no ha comprado, con el descuento de la configuración." styleClass="form-hint" wrapText="true"/>
                        <ComboBox fx:id="promotionsCustomerBox" promptText="Seleccionar cliente..." maxWidth="Infinity"/>
                        <TableView fx:id="promotionsTable" styleClass="compact-table" prefHeight="190">
                            <columns>
                                <TableColumn fx:id="promoProductColumn" text="Producto" prefWidth="150" sortable="false"/>
                                <TableColumn fx:id="promoRegularColumn" text="Normal" prefWidth="80" sortable="false"/>
                                <TableColumn fx:id="promoDiscountColumn" text="Descuento" prefWidth="70" sortable="false"/>
                                <TableColumn fx:id="promoPriceColumn" text="Promoción" prefWidth="80" sortable="false"/>
                            </columns>
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                            <placeholder><Label text="Elige un cliente para ver sus promociones" styleClass="placeholder-notice"/></placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
