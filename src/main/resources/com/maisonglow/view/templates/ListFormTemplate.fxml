<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- PLANTILLA de una pantalla "lista + formulario" (mockups M2 Clientes y M4 Productos).
     Copiala a src/main/resources/com/maisonglow/view/<Nombre>View.fxml, ajusta los textos,
     las columnas y los campos en Scene Builder, y agrega fx:controller. No se carga sola.
     Los textos "Mensaje de error" se ven aqui para disenar; FieldValidator los oculta al arrancar
     y solo muestra el del campo que falla. Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="view-root" stylesheets="@../styles.css" prefWidth="1000" prefHeight="660">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
    <center>
        <VBox spacing="16">
            <BorderPane.margin><Insets right="20"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Título de la vista" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="newButton" text="Nuevo" styleClass="button-gold">
                    <graphic><StackPane styleClass="sparkle" minWidth="15" prefWidth="15" maxWidth="15" minHeight="15" prefHeight="15" maxHeight="15">
                        <SVGPath styleClass="line-icon" scaleX="0.625" scaleY="0.625" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/>
                    </StackPane></graphic>
                </Button>
            </HBox>
            <TextField fx:id="searchField" promptText="Buscar..." styleClass="search-field"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn text="Nombre" prefWidth="220"/>
                    <TableColumn text="Detalle" prefWidth="260"/>
                    <TableColumn text="Estado" prefWidth="120"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Aún no hay registros" styleClass="placeholder-notice"/></placeholder>
            </TableView>
        </VBox>
    </center>
    <right>
        <VBox styleClass="card, form-card" spacing="6" prefWidth="320" minWidth="320">
            <Label text="Registrar" styleClass="form-title"/>

            <Label text="Nombre" styleClass="form-label"/>
            <TextField fx:id="nameField" promptText="Escribe el nombre"/>
            <Label fx:id="nameMessage" text="Mensaje de error" styleClass="field-error-message"/>

            <Label text="Categoría" styleClass="form-label"/>
            <ComboBox fx:id="categoryBox" promptText="Selecciona" maxWidth="Infinity"/>
            <Label fx:id="categoryMessage" text="Mensaje de error" styleClass="field-error-message"/>

            <Label text="Precio" styleClass="form-label"/>
            <TextField fx:id="priceField" promptText="0"/>
            <Label fx:id="priceMessage" text="Mensaje de error" styleClass="field-error-message"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Button fx:id="saveButton" text="Guardar" styleClass="button-primary" maxWidth="Infinity"/>
            <Button fx:id="cancelButton" text="Cancelar" styleClass="button-secondary" maxWidth="Infinity"/>
        </VBox>
    </right>
</BorderPane>
