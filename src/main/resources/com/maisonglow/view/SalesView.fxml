<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de Nueva venta (mockup M6): a la izquierda el cliente y el catalogo, a la derecha el carrito.
     Los textos de ejemplo ("Mensaje de error", el total) se ven aqui para disenar; SalesController los
     reemplaza al arrancar. Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.SalesController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="660">
    <top>
        <Label text="Nueva venta" styleClass="view-title">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="12">
            <BorderPane.margin><Insets right="20"/></BorderPane.margin>

            <VBox spacing="6">
                <Label text="Cliente" styleClass="form-label"/>
                <ComboBox fx:id="customerBox" promptText="Selecciona un cliente" maxWidth="Infinity"/>
                <Label fx:id="customerMessage" text="Mensaje de error" styleClass="field-error-message"/>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="searchField" promptText="Buscar en el catálogo..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <ToggleButton fx:id="productsChip" text="Productos" styleClass="filter-chip" selected="true">
                        <toggleGroup><ToggleGroup fx:id="kindGroup"/></toggleGroup>
                    </ToggleButton>
                    <ToggleButton fx:id="treatmentsChip" text="Tratamientos" styleClass="filter-chip">
                        <toggleGroup><fx:reference source="kindGroup"/></toggleGroup>
                    </ToggleButton>
                </HBox>
            </HBox>

            <TableView fx:id="catalogTable" styleClass="compact-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="catalogNameColumn" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="catalogPriceColumn" text="Precio" prefWidth="100"/>
                    <TableColumn fx:id="catalogAvailableColumn" text="Disponible" prefWidth="100"/>
                    <TableColumn fx:id="catalogActionColumn" text="Agregar" prefWidth="64" sortable="false"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No hay nada que coincida con la búsqueda" styleClass="placeholder-notice"/></placeholder>
            </TableView>
        </VBox>
    </center>
    <right>
        <VBox styleClass="card, form-card" spacing="8" prefWidth="400" minWidth="400">
            <Label text="Venta actual" styleClass="form-title"/>

            <TableView fx:id="cartTable" styleClass="compact-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="cartNameColumn" text="Ítem" prefWidth="160" sortable="false"/>
                    <TableColumn fx:id="cartQuantityColumn" text="Cantidad" prefWidth="92" sortable="false"/>
                    <TableColumn fx:id="cartSubtotalColumn" text="Subtotal" prefWidth="80" sortable="false"/>
                    <TableColumn fx:id="cartRemoveColumn" text="" prefWidth="38" sortable="false"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Agrega productos o tratamientos desde el catálogo" styleClass="placeholder-notice" wrapText="true"/></placeholder>
            </TableView>
            <Label fx:id="cartMessage" text="Mensaje de error" styleClass="field-error-message"/>

            <HBox alignment="CENTER_LEFT">
                <Label text="Total" styleClass="total-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="totalLabel" text="\$ 0" styleClass="total-amount"/>
            </HBox>

            <HBox spacing="10">
                <padding><Insets top="6"/></padding>
                <Button fx:id="clearButton" text="Vaciar" styleClass="button-secondary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button fx:id="chargeButton" text="Cobrar" styleClass="button-gold, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
        </VBox>
    </right>
</BorderPane>
