<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Mi perfil del cliente (N-R01). A la izquierda sus datos de contacto: el documento se ve pero no se edita; el nombre, el
     telefono y el correo si, con el error debajo de cada campo. A la derecha la seguridad: cambiar la contrasena abre la
     misma ventana del menu y, como el servicio cierra las sesiones al cambiarla, vuelve al inicio de sesion. El rol, la
     identidad vinculada y las inasistencias no se editan aqui. Los textos "Mensaje de error" se ven aqui solo para disenar.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.ProfileController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="660">
    <top>
        <VBox spacing="2">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <Label text="Mi perfil" styleClass="view-title"/>
            <Label text="Tus datos de contacto y la seguridad de tu cuenta." styleClass="form-hint"/>
        </VBox>
    </top>
    <center>
        <HBox spacing="18" alignment="TOP_LEFT">
            <VBox styleClass="card, form-card" spacing="6" prefWidth="0" HBox.hgrow="ALWAYS" maxHeight="-Infinity">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <StackPane styleClass="stat-medallion" minWidth="56" prefWidth="56" maxWidth="56" minHeight="56" prefHeight="56" maxHeight="56">
                        <Label fx:id="initialsLabel" text="AG" styleClass="stat-initials"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="nameTitle" text="Ana García" styleClass="stat-name"/>
                        <Label fx:id="documentLabel" text="Documento 1001234567" styleClass="form-hint"/>
                    </VBox>
                </HBox>
                <Label text="Nombre completo" styleClass="form-label">
                    <VBox.margin><Insets top="10"/></VBox.margin>
                </Label>
                <TextField fx:id="nameField" promptText="Ana García"/>
                <Label fx:id="nameMessage" text="Mensaje de error" styleClass="field-error-message"/>
                <Label text="Teléfono" styleClass="form-label"/>
                <TextField fx:id="phoneField" promptText="3001112233"/>
                <Label fx:id="phoneMessage" text="Mensaje de error" styleClass="field-error-message"/>
                <Label text="Correo" styleClass="form-label"/>
                <TextField fx:id="emailField" promptText="ana@correo.com"/>
                <Label fx:id="emailMessage" text="Mensaje de error" styleClass="field-error-message"/>
                <HBox spacing="10">
                    <padding><Insets top="10"/></padding>
                    <Button fx:id="saveButton" text="Guardar cambios" styleClass="button-gold, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button fx:id="discardButton" text="Descartar" styleClass="button-secondary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
            <VBox styleClass="card, form-card" spacing="8" prefWidth="0" HBox.hgrow="ALWAYS" maxHeight="-Infinity">
                <Label text="Seguridad" styleClass="form-title"/>
                <Label text="Cambiar tu contraseña cierra tu sesión: tendrás que entrar de nuevo con la nueva." styleClass="form-hint" wrapText="true"/>
                <Button fx:id="passwordButton" text="Cambiar contraseña" styleClass="button-secondary, button-compact" maxWidth="Infinity">
                    <VBox.margin><Insets top="6"/></VBox.margin>
                </Button>
            </VBox>
        </HBox>
    </center>
</BorderPane>
