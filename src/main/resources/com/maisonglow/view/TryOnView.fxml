<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
 fx:controller="com.maisonglow.view.controller.TryOnController" styleClass="view-root, tryon-root" stylesheets="@styles.css" prefWidth="1250" prefHeight="760">
 <center>
  <ScrollPane fitToWidth="true" styleClass="tryon-scroll" hbarPolicy="NEVER">
   <content><VBox spacing="20">
    <HBox alignment="CENTER_LEFT" spacing="14">
     <SVGPath styleClass="line-icon" style="-fx-stroke: -mg-gold;" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/>
     <Label text="Probador virtual" styleClass="view-title" wrapText="true"/>
     <Label text="IA" styleClass="chip-gold"/>
     <Region HBox.hgrow="ALWAYS"/>
     <VBox spacing="6" minWidth="220" prefWidth="300" maxWidth="360">
      <Label text="Cliente *" styleClass="tryon-label" labelFor="$customerBox"/>
      <ComboBox fx:id="customerBox" editable="true" promptText="Buscar cliente..." maxWidth="Infinity" accessibleText="Buscar cliente por nombre o documento"/>
      <Label fx:id="customerMessage" styleClass="field-error-message" wrapText="true"/>
     </VBox>
    </HBox>
    <HBox fx:id="simulatedBanner" styleClass="banner-warning">
     <Label text="Modo simulado: vista de ejemplo con tinte de color. No modifica únicamente el cabello." styleClass="banner-text" wrapText="true"/>
    </HBox>
    <GridPane hgap="16" minHeight="510" prefHeight="560">
     <columnConstraints>
      <ColumnConstraints percentWidth="32" minWidth="0"/>
      <ColumnConstraints percentWidth="34" minWidth="0"/>
      <ColumnConstraints percentWidth="34" minWidth="0"/>
     </columnConstraints>
     <children>
      <VBox styleClass="card, tryon-card" spacing="12" GridPane.columnIndex="0" fillWidth="true">
       <Label text="Foto de referencia" styleClass="tryon-card-title" wrapText="true"/>
       <StackPane fx:id="photoFrame" styleClass="photo-frame" minWidth="0" prefWidth="0" minHeight="240" prefHeight="360" VBox.vgrow="ALWAYS">
        <ImageView fx:id="photoView" preserveRatio="true" accessibleText="Foto de referencia seleccionada"/>
        <Label fx:id="photoPlaceholder" text="Sube una foto para comenzar" styleClass="placeholder-notice" wrapText="true"/>
       </StackPane>
       <Button fx:id="cameraButton" text="Tomar foto" styleClass="button-secondary" maxWidth="Infinity"/>
       <Button fx:id="uploadButton" text="Subir foto" styleClass="button-secondary" maxWidth="Infinity"/>
       <Label text="JPG o PNG · Hasta 10 MB" styleClass="form-hint" wrapText="true"/>
       <Label fx:id="photoMessage" styleClass="field-error-message" wrapText="true"/>
      </VBox>
      <VBox styleClass="card, tryon-card" spacing="16" GridPane.columnIndex="1">
       <Label text="¿Qué quieres probar?" styleClass="tryon-card-title" wrapText="true"/>
       <Label text="Color de cabello" styleClass="tryon-category"/>
       <Label text="Paleta de color" styleClass="tryon-label"/>
       <TilePane fx:id="transformationChips" maxWidth="274" prefColumns="5" prefTileWidth="50" prefTileHeight="50" hgap="6" vgap="10"/>
       <Label fx:id="selectedToneLabel" text="Selecciona una tonalidad" styleClass="tryon-tone-name" wrapText="true"/>
       <Label fx:id="transformationMessage" styleClass="field-error-message" wrapText="true"/>
       <Region VBox.vgrow="ALWAYS"/>
       <HBox alignment="CENTER_LEFT"><Label text="Intensidad" styleClass="tryon-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="intensityValue" styleClass="tryon-tone-name"/></HBox>
       <Slider fx:id="intensitySlider" min="0" max="1" value="0.5" blockIncrement="0.1" accessibleText="Intensidad del color"/>
       <HBox><Label text="Suave" styleClass="form-hint"/><Region HBox.hgrow="ALWAYS"/><Label text="Media" styleClass="form-hint"/><Region HBox.hgrow="ALWAYS"/><Label text="Intensa" styleClass="form-hint"/></HBox>
      </VBox>
      <VBox styleClass="card, tryon-card" spacing="12" GridPane.columnIndex="2">
       <Label text="Resultado" styleClass="tryon-card-title"/>
       <StackPane fx:id="resultFrame" styleClass="photo-frame" minWidth="0" prefWidth="0" minHeight="240" prefHeight="360" VBox.vgrow="ALWAYS">
        <ImageView fx:id="resultView" preserveRatio="true" accessibleText="Resultado de la simulación"/>
        <Label fx:id="resultPlaceholder" text="Aquí aparece el resultado" styleClass="placeholder-notice" wrapText="true"/>
        <HBox fx:id="comparisonBadges" visible="false" mouseTransparent="true" alignment="TOP_CENTER" spacing="8">
         <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
         <Label text="Antes" styleClass="tryon-comparison-badge"/><Region HBox.hgrow="ALWAYS"/><Label text="Después" styleClass="tryon-comparison-badge"/>
        </HBox>
       </StackPane>
       <Slider fx:id="comparisonSlider" min="0" max="1" value="0.5" visible="false" managed="false" accessibleText="Comparar antes y después"/>
       <Label fx:id="comparisonHint" text="Compara el resultado con la foto de referencia a la izquierda." styleClass="form-hint" wrapText="true" visible="false" managed="false"/>
       <Label fx:id="disclaimerLabel" text="Simulación, no garantía" styleClass="form-hint" wrapText="true"/>
       <HBox spacing="10">
        <Button fx:id="generateButton" text="Generar simulación" styleClass="button-gold" maxWidth="Infinity" HBox.hgrow="ALWAYS" wrapText="true"/>
        <Button fx:id="saveButton" text="Guardar" styleClass="button-secondary"/>
       </HBox>
      </VBox>
     </children>
    </GridPane>
   </VBox></content>
  </ScrollPane>
 </center>
</BorderPane>
