<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla de Inicio. Arriba una cabecera con el saludo, la fecha y una frase con lo que hay hoy; debajo cuatro
     indicadores (citas de hoy, por confirmar, ventas de hoy y poco stock) cada uno con su icono, y dos tarjetas:
     la agenda de hoy y los productos por reponer. Las filas de las listas las arma HomeController; aqui se ven dos
     de ejemplo para disenar. Solo muestra datos que ya existen.
     Colores y formas: View > Scene Style Sheets > styles.css (clases home-*). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.HomeController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1100" prefHeight="700">
    <top>
        <HBox styleClass="home-hero" alignment="CENTER_LEFT" spacing="16">
            <BorderPane.margin><Insets bottom="18"/></BorderPane.margin>
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="MAISON GLOW" styleClass="home-eyebrow"/>
                <Label fx:id="greetingLabel" text="Buenos días" styleClass="home-greeting"/>
                <Label fx:id="dateLabel" text="Lunes, 16 de noviembre de 2026" styleClass="home-date"/>
                <Label fx:id="summaryLabel" text="Hoy tienes 4 citas y 2 esperan tu confirmación." styleClass="home-summary" wrapText="true"/>
            </VBox>
            <StackPane styleClass="home-hero-star" minWidth="64" prefWidth="64" maxWidth="64" minHeight="64" prefHeight="64" maxHeight="64">
                <SVGPath styleClass="home-hero-star-icon" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z" scaleX="1.6" scaleY="1.6"/>
            </StackPane>
        </HBox>
    </top>
    <center>
        <VBox spacing="18">
            <HBox spacing="14">
                <HBox styleClass="home-kpi, home-kpi-gold" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M8 2v4M16 2v4M3 10h18M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Citas de hoy" styleClass="stat-caption"/><Label fx:id="todayValue" text="5" styleClass="home-kpi-number"/><Label fx:id="todayNote" text="2 por atender" styleClass="home-kpi-note"/></VBox>
                </HBox>
                <HBox styleClass="home-kpi, home-kpi-rose" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M12 6v6l4 2M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Por confirmar" styleClass="stat-caption"/><Label fx:id="pendingValue" text="3" styleClass="home-kpi-number"/><Label text="Citas pendientes" styleClass="home-kpi-note"/></VBox>
                </HBox>
                <HBox styleClass="home-kpi, home-kpi-green" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4zM3 6h18M16 10a4 4 0 0 1-8 0"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Ventas de hoy" styleClass="stat-caption"/><Label fx:id="salesValue" text="\$ 120.000" styleClass="home-kpi-number"/><Label fx:id="salesNote" text="2 ventas" styleClass="home-kpi-note"/></VBox>
                </HBox>
                <HBox fx:id="stockTile" styleClass="home-kpi, home-kpi-alert" spacing="14" alignment="CENTER_LEFT" prefWidth="0" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="home-kpi-icon" minWidth="44" prefWidth="44" maxWidth="44" minHeight="44" prefHeight="44" maxHeight="44">
                        <SVGPath styleClass="line-icon" content="M21 8l-9-5-9 5v8l9 5 9-5zM3 8l9 5 9-5M12 13v8"/>
                    </StackPane>
                    <VBox spacing="1"><Label text="Poco stock" styleClass="stat-caption"/><Label fx:id="lowStockValue" text="4" styleClass="home-kpi-number"/><Label text="Productos por reponer" styleClass="home-kpi-note"/></VBox>
                </HBox>
            </HBox>
            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox styleClass="card, form-card" spacing="12" prefWidth="0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Agenda de hoy" styleClass="home-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="agendaCount" text="4 citas" styleClass="chip-rose"/>
                    </HBox>
                    <VBox fx:id="agendaBox" spacing="10">
                        <Label text="09:00 · Ana García · Corte y peinado" styleClass="form-hint"/>
                        <Label text="11:30 · Laura Pérez · Manicure" styleClass="form-hint"/>
                    </VBox>
                    <Label fx:id="agendaEmpty" text="Hoy no hay citas. Un buen día para organizar la semana." styleClass="home-empty" wrapText="true"/>
                </VBox>
                <VBox styleClass="card, form-card" spacing="12" prefWidth="0" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Por reponer" styleClass="home-card-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="restockCount" text="1 producto" styleClass="chip-rose"/>
                    </HBox>
                    <VBox fx:id="restockBox" spacing="10">
                        <Label text="Mascarilla Reparadora · quedan 1 de 5" styleClass="form-hint"/>
                    </VBox>
                    <Label fx:id="restockEmpty" text="Todo el inventario está al día." styleClass="home-empty" wrapText="true"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
