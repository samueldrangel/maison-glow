<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Pantalla de Agenda de citas (mockup M5). Arriba se elige que citas ver: las proximas, las de hoy, las pasadas o las de un
     dia (solo entonces aparecen el selector de fecha y sus flechas); en el centro las citas del dia y debajo los botones que cambian el estado de la cita
     elegida (el controlador los activa solo cuando ese cambio es posible). El formulario de agendar y
     reprogramar es un panel que entra desde la derecha (AppointmentFormPane.fxml). Los textos de ejemplo se ven aqui
     para disenar; AppointmentsController los reemplaza al arrancar.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.AppointmentsController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="660">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <Label text="Agenda" styleClass="view-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER_RIGHT" spacing="8">
                <ToggleButton fx:id="upcomingChip" text="Próximas" styleClass="filter-chip" selected="true">
                    <toggleGroup><ToggleGroup fx:id="modeChips"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="todayChip" text="Hoy" styleClass="filter-chip">
                    <toggleGroup><fx:reference source="modeChips"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="pastChip" text="Pasadas" styleClass="filter-chip">
                    <toggleGroup><fx:reference source="modeChips"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="dayChip" text="Un día" styleClass="filter-chip">
                    <toggleGroup><fx:reference source="modeChips"/></toggleGroup>
                </ToggleButton>
            </HBox>
            <Button fx:id="newButton" text="Nueva cita" styleClass="button-gold"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label fx:id="dayTitle" text="Próximas citas · próximos 60 días" styleClass="day-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="dayControls" alignment="CENTER_RIGHT" spacing="8">
                    <Button fx:id="previousButton" text="‹" styleClass="icon-button, day-arrow"/>
                    <DatePicker fx:id="dayPicker" prefWidth="170"/>
                    <Button fx:id="nextButton" text="›" styleClass="icon-button, day-arrow"/>
                </HBox>
            </HBox>
            <TableView fx:id="appointmentsTable" styleClass="compact-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" text="Fecha" prefWidth="80"/>
                    <TableColumn fx:id="timeColumn" text="Hora" prefWidth="110"/>
                    <TableColumn fx:id="customerColumn" text="Cliente" prefWidth="150"/>
                    <TableColumn fx:id="treatmentColumn" text="Tratamiento" prefWidth="150"/>
                    <TableColumn fx:id="professionalColumn" text="Profesional" prefWidth="140"/>
                    <TableColumn fx:id="statusColumn" text="Estado" prefWidth="110"/>
                    <TableColumn fx:id="depositColumn" text="Anticipo" prefWidth="90"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="No hay citas este día" styleClass="placeholder-notice"/></placeholder>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="countLabel" text="3 citas" styleClass="stat-caption"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="confirmButton" text="Confirmar" styleClass="button-primary, button-compact"/>
                <Button fx:id="rescheduleButton" text="Reprogramar" styleClass="button-secondary, button-compact"/>
                <Button fx:id="completeButton" text="Completar" styleClass="button-secondary, button-compact"/>
                <Button fx:id="noShowButton" text="Inasistencia" styleClass="button-secondary, button-compact"/>
                <Button fx:id="cancelAppointmentButton" text="Cancelar cita" styleClass="button-secondary, button-compact"/>
            </HBox>
        </VBox>
    </center>
    <right>
        <fx:include fx:id="form" source="AppointmentFormPane.fxml"/>
    </right>
</BorderPane>
