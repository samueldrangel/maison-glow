<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- Pantalla de Productos e Inventario (mockup M4). Parte de templates/ListFormTemplate.fxml.
     Los textos de ejemplo (el aviso, las categorias, "Mensaje de error") se ven aqui para disenar;
     ProductsController los reemplaza al arrancar con los datos reales.
     Colores: View > Scene Style Sheets > styles.css. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.ProductsController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1000" prefHeight="660">
    <center>
        <VBox spacing="14">
            <BorderPane.margin><Insets right="20"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Productos" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="newButton" text="Nuevo producto" styleClass="button-gold">
                    <graphic><StackPane styleClass="sparkle" minWidth="15" prefWidth="15" maxWidth="15" minHeight="15" prefHeight="15" maxHeight="15">
                        <SVGPath styleClass="line-icon" scaleX="0.625" scaleY="0.625" content="M12 2l2.4 7.6L22 12l-7.6 2.4L12 22l-2.4-7.6L2 12l7.6-2.4z"/>
                    </StackPane></graphic>
                </Button>
            </HBox>

            <HBox fx:id="lowStockBanner" styleClass="banner-warning">
                <StackPane minWidth="20" prefWidth="20" maxWidth="20" minHeight="20" prefHeight="20" maxHeight="20">
                    <SVGPath styleClass="line-icon" scaleX="0.83" scaleY="0.83" content="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z M12 9v4 M12 17h.01"/>
                </StackPane>
                <Label fx:id="lowStockText" text="2 productos por debajo del stock mínimo" styleClass="banner-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="lowStockButton" text="Ver solo esos" styleClass="button-secondary"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <TextField fx:id="searchField" promptText="Buscar producto..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <HBox fx:id="categoryChips" alignment="CENTER_RIGHT" spacing="8">
                    <ToggleButton text="Cabello" styleClass="filter-chip"/>
                    <ToggleButton text="Piel" styleClass="filter-chip"/>
                    <ToggleButton text="Uñas" styleClass="filter-chip"/>
                    <ToggleButton text="Maquillaje" styleClass="filter-chip"/>
                </HBox>
            </HBox>

            <TableView fx:id="productsTable" styleClass="compact-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Producto" prefWidth="160"/>
                    <TableColumn fx:id="categoryColumn" text="Categoría" prefWidth="88"/>
                    <TableColumn fx:id="priceColumn" text="Precio" prefWidth="82"/>
                    <TableColumn fx:id="stockColumn" text="Stock" prefWidth="52"/>
                    <TableColumn fx:id="minimumColumn" text="Mínimo" prefWidth="62"/>
                    <TableColumn fx:id="statusColumn" text="Estado" prefWidth="118"/>
                    <TableColumn fx:id="actionsColumn" text="Acciones" prefWidth="72" sortable="false"/>
                </columns>
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <placeholder><Label text="Aún no hay productos. Pulsa «Nuevo producto» para registrar el primero." styleClass="placeholder-notice"/></placeholder>
            </TableView>
        </VBox>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefWidth="310" minWidth="310">
            <VBox spacing="16" styleClass="side-column">
                <VBox styleClass="card, form-card" spacing="6">
                    <Label fx:id="formTitle" text="Registrar producto" styleClass="form-title"/>

                    <Label text="Nombre" styleClass="form-label"/>
                    <TextField fx:id="nameField" promptText="Nombre del producto"/>
                    <Label fx:id="nameMessage" text="Mensaje de error" styleClass="field-error-message"/>

                    <Label text="Categoría" styleClass="form-label"/>
                    <ComboBox fx:id="categoryBox" promptText="Selecciona" maxWidth="Infinity"/>
                    <Label fx:id="categoryMessage" text="Mensaje de error" styleClass="field-error-message"/>

                    <Label text="Precio" styleClass="form-label"/>
                    <TextField fx:id="priceField" promptText="28000"/>
                    <Label fx:id="priceMessage" text="Mensaje de error" styleClass="field-error-message"/>

                    <HBox spacing="10">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Stock mínimo" styleClass="form-label"/>
                            <TextField fx:id="minimumField" promptText="10"/>
                            <Label fx:id="minimumMessage" text="Mensaje de error" styleClass="field-error-message"/>
                        </VBox>
                        <VBox fx:id="initialStockBox" spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Stock inicial" styleClass="form-label"/>
                            <TextField fx:id="initialStockField" promptText="0"/>
                            <Label fx:id="initialStockMessage" text="Mensaje de error" styleClass="field-error-message"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="10">
                        <padding><Insets top="10"/></padding>
                        <Button fx:id="saveButton" text="Guardar" styleClass="button-primary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="cancelButton" text="Cancelar" styleClass="button-secondary, button-compact" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <VBox styleClass="card, form-card" spacing="6">
                    <Label text="Ajustar stock" styleClass="form-title"/>

                    <Label text="Producto" styleClass="form-label"/>
                    <ComboBox fx:id="adjustProductBox" promptText="Seleccionar producto..." maxWidth="Infinity"/>
                    <Label fx:id="adjustProductMessage" text="Mensaje de error" styleClass="field-error-message"/>

                    <Label text="Cantidad (negativa para restar)" styleClass="form-label"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Button fx:id="minusButton" styleClass="icon-button">
                            <graphic><StackPane minWidth="16" prefWidth="16" maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16">
                                <SVGPath styleClass="line-icon" scaleX="0.67" scaleY="0.67" content="M5 12h14"/>
                            </StackPane></graphic>
                        </Button>
                        <TextField fx:id="quantityField" text="1" alignment="CENTER" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="plusButton" styleClass="icon-button">
                            <graphic><StackPane minWidth="16" prefWidth="16" maxWidth="16" minHeight="16" prefHeight="16" maxHeight="16">
                                <SVGPath styleClass="line-icon" scaleX="0.67" scaleY="0.67" content="M12 5v14 M5 12h14"/>
                            </StackPane></graphic>
                        </Button>
                    </HBox>
                    <Label fx:id="quantityMessage" text="Mensaje de error" styleClass="field-error-message"/>

                    <Button fx:id="adjustButton" text="Guardar ajuste" styleClass="button-primary" maxWidth="Infinity">
                        <VBox.margin><Insets top="10"/></VBox.margin>
                    </Button>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
