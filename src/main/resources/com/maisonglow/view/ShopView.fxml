<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Tienda del cliente (N-R02). Arriba el buscador y las categorias; en el centro las tarjetas de los productos publicados
     con su portada, precio y disponibilidad; a la derecha el detalle del producto elegido. Solo se ve lo que el negocio
     publico: ninguna cifra interna de inventario, solo "Disponible", "Pocas unidades" o "Agotado". Un producto que el negocio
     retira mientras se mira deja de poder pedirse y el detalle lo avisa. Las tarjetas son de ejemplo para disenar;
     ShopController las reemplaza.
     Colores: View > Scene Style Sheets > styles.css (clases shop-*). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.maisonglow.view.controller.ShopController"
            styleClass="view-root" stylesheets="@styles.css" prefWidth="1100" prefHeight="700">
    <top>
        <VBox spacing="10">
            <BorderPane.margin><Insets bottom="14"/></BorderPane.margin>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Tienda" styleClass="view-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox fx:id="categoryChips" alignment="CENTER_RIGHT" spacing="8"/>
            </HBox>
            <TextField fx:id="searchField" promptText="Buscar producto..." styleClass="search-field"/>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="gridHost">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll">
                <FlowPane fx:id="productsPane" hgap="16" vgap="16">
                    <padding><Insets top="4" right="8" bottom="16" left="4"/></padding>
                    <VBox styleClass="card, shop-card" spacing="6" prefWidth="210">
                        <StackPane styleClass="photo-frame" prefHeight="140"><Label text="Sin foto" styleClass="placeholder-notice"/></StackPane>
                        <Label text="Sérum Vitamina C" styleClass="home-row-title"/>
                        <Label text="Piel" styleClass="stat-caption"/>
                        <HBox alignment="CENTER_LEFT" spacing="8"><Label text="\$ 48.000" styleClass="shop-price"/><Region HBox.hgrow="ALWAYS"/><Label text="Disponible" styleClass="chip-success"/></HBox>
                    </VBox>
                </FlowPane>
            </ScrollPane>
            <Label fx:id="emptyLabel" text="Aún no hay productos en la tienda." styleClass="home-empty" wrapText="true" maxWidth="360" StackPane.alignment="CENTER"/>
        </StackPane>
    </center>
    <right>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="side-scroll" prefWidth="330" minWidth="330">
            <VBox spacing="16" styleClass="side-column">
                <VBox styleClass="card, form-card" spacing="8">
                    <Label fx:id="detailEmpty" text="Elige un producto para ver su detalle." styleClass="placeholder-notice" wrapText="true"/>
                    <VBox fx:id="detailBox" spacing="8">
                        <StackPane styleClass="photo-frame" minHeight="200" prefHeight="220">
                            <ImageView fx:id="detailCover" fitWidth="280" fitHeight="200" preserveRatio="true"/>
                            <Label fx:id="detailPlaceholder" text="Sin foto" styleClass="placeholder-notice"/>
                        </StackPane>
                        <Label fx:id="detailName" text="Sérum Vitamina C" styleClass="form-title" wrapText="true"/>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="detailCategory" text="Piel" styleClass="chip-rose"/>
                            <Label fx:id="detailAvailability" text="Disponible" styleClass="chip-success"/>
                        </HBox>
                        <Label fx:id="detailPrice" text="\$ 48.000" styleClass="shop-price-big"/>
                        <HBox fx:id="detailUnavailable" styleClass="banner-warning">
                            <Label text="Este producto ya no está disponible en la tienda." styleClass="banner-text" wrapText="true"/>
                        </HBox>
                        <Label fx:id="detailNote" text="Se paga y se retira en el local." styleClass="form-hint" wrapText="true"/>
                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </right>
</BorderPane>
